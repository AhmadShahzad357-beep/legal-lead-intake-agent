# Is file ka naam ".env" rakh kar apni real keys yahan daalein.
# Jab tak koi key khali hai, uska tool "TEST MODE" mein chalega
# (real call nahi hogi, bas terminal mein print hoga) — baki jinki
# key bhar di hai, wo REAL chalenge. Yani partial setup bhi chalta hai.

# TEST_MODE ko false karein jab sab real ho chuka ho aur aap chahte
# hain Slack/WhatsApp bhi zaroor real jayen (crm.py sirf apni key check
# karta hai, lekin notifier.py/responder.py TEST_MODE ko bhi dekhte hain).
TEST_MODE=false

# --- LLM Provider: Groq (free) ---
# 1. https://console.groq.com par jayein -> sign up (free, no card)
# 2. API Keys -> Create Key -> yahan paste karein
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- HubSpot (CRM) ---
# 1. https://app.hubspot.com -> free account
# 2. Settings -> Integrations -> Private Apps -> Create a private app
# 3. Scopes: crm.objects.contacts.read + crm.objects.contacts.write
# 4. Copy the generated token here
HUBSPOT_API_KEY=

# --- Slack (team notification) ---
# 1. https://api.slack.com/apps -> Create New App -> From scratch
# 2. Incoming Webhooks -> Activate -> Add New Webhook to Workspace
# 3. Copy the Webhook URL here
SLACK_WEBHOOK_URL=

# --- Meta WhatsApp Cloud API (prospect ko auto-reply WhatsApp) ---
# 1. https://developers.facebook.com -> My Apps -> Create App -> Business
# 2. App dashboard -> WhatsApp -> API Setup: Phone number ID copy karein
# 3. Business Settings -> System Users: permanent token banayein; permissions
#    whatsapp_business_messaging + whatsapp_business_management dein.
# 4. WhatsApp Manager -> Message templates mein approved Utility template banayein.
#    Suggested body: "Hi {{1}}, thank you for contacting [Firm Name]. We have
#    received your inquiry. A member of our intake team will contact you shortly."
#    Is code ke liye template body ka pehla variable {{1}} (lead name) hona zaroori hai.
WHATSAPP_ACCESS_TOKEN=EAA6bK9pPxQ4BSchU1tFlMrSqgEWbm0UneNTnuwtrheEGd7y7HFFCopdKqZAYVXMZBmXkr4bR5PZAPBPSF2qQMXZBzOYctN5aOrZAQzIrrMHiJqHzD83CjZARUu6qN7Wiic2lyOQk5d652WhPNZBRDtn9SatCuZBZADzjYMykj2ZBZCRNFAzhcWVSZBOrs25f2ssj8iddnxAD6C2YlQacJJqQDWMOpSY3Pto1Q9EM4WEwvd9hUpHkVyNnJHRgPKEOW067WSWMtZCGKXzP9Bv8KMG1ZBSjyIk2PR
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=lead_intake_auto_reply
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Webhook security ---
# Is secret ko apne form-builder / CallRail / LSA config mein bhi
# daalna hoga (query param ?secret=... ke tor pe) taake koi aur
# random insaan aapke /webhook/lead par fake leads na bhej sake.
WEBHOOK_SECRET=change-this-to-a-random-string
